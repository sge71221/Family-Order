/** add-record.wxss */
@import '../../styles/mixins.wxss';

.add-record-page {
  padding: var(--spacing-sm);
  padding-bottom: 120px;
}

.add-record-header {
  margin-bottom: var(--spacing-md);
  align-items: center;
}

.header-title {
  font-size: 18px;
  font-weight: var(--font-weight-bold);
  color: var(--color-on-surface);
}

.header-back {
  font-size: 22px;
  color: var(--color-on-surface);
  padding: 8px;
}

.form-row {
  background-color: var(--color-surface);
  border-radius: var(--radius-card);
  padding: 14px 16px;
  margin-bottom: var(--spacing-sm);
  align-items: center;
}

.form-row__label {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: var(--font-size-body);
  color: var(--color-on-surface);
}

.form-row__value {
  font-size: var(--font-size-body);
  color: var(--color-on-surface);
}

.form-row__arrow {
  color: var(--color-on-surface-light);
  margin-left: 4px;
}

.form-group {
  margin-bottom: var(--spacing-sm);
}

.form-row-double {
  gap: 12px;
  margin-bottom: var(--spacing-sm);
}

.form-row-double .form-group {
  margin-bottom: 0;
}

.form-label {
  font-size: 14px;
  color: var(--color-on-surface-muted);
  display: block;
  margin-bottom: 8px;
}

.required {
  color: var(--color-error);
}

.form-input {
  background-color: var(--color-surface);
  border-radius: var(--radius-input);
  padding: 12px 16px;
  font-size: var(--font-size-body);
  color: var(--color-on-surface);
  border: 1rpx solid var(--color-divider);
}

.form-input--picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-textarea {
  background-color: var(--color-surface);
  border-radius: var(--radius-input);
  padding: 12px 16px;
  font-size: var(--font-size-body);
  color: var(--color-on-surface);
  border: 1rpx solid var(--color-divider);
  width: 100%;
  height: 80px;
  box-sizing: border-box;
}

.category-list {
  gap: 10px;
  flex-wrap: wrap;
}

.category-tag {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 14px;
  border-radius: 20px;
  background-color: var(--color-surface);
  border: 1rpx solid var(--color-divider);
  font-size: 13px;
  color: var(--color-on-surface-muted);
}

.category-tag--active {
  border-color: var(--cat-color, var(--color-primary));
  color: var(--cat-color, var(--color-primary));
  background-color: var(--color-surface);
}

.category-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
}

.temp-total {
  background-color: var(--color-primary-bg);
  border-radius: var(--radius-card);
  padding: 14px 16px;
  margin-bottom: var(--spacing-sm);
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: var(--font-size-body);
  color: var(--color-on-surface);
}

.temp-total__amount {
  font-size: 18px;
  font-weight: var(--font-weight-bold);
  color: var(--color-on-surface);
}

.form-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: var(--spacing-sm) var(--spacing-sm) calc(var(--spacing-sm) + env(safe-area-inset-bottom));
  background-color: var(--color-bg);
  align-items: center;
  gap: var(--spacing-sm);
  z-index: var(--z-fixed);
}

.btn-cancel {
  font-size: var(--font-size-body);
  color: var(--color-on-surface-muted);
  padding: 12px 16px;
  flex-shrink: 0;
}

.btn-save {
  flex: 1;
  background-color: var(--color-primary);
  color: #FFFFFF;
  border-radius: var(--radius-button);
  min-height: 48px;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-save.disabled {
  opacity: 0.5;
}
